{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "lib": ["ES2020"],
    "types": []
  },
  "include": ["tests/**/*.d.ts", "tests/unit/**/*.test.ts"]
}
