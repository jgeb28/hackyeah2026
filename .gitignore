# --- Build output & caches ---
**/build/
**/oh_modules/
**/.hvigor/
.hvigor/
/hvigor/
BuildProfile.ets
**/BuildProfile.ets
*.hap
*.hsp
*.har
*.abc

# --- Local-only tooling (kept on disk, not committed) ---
.opencode/
tests/*.sh

# --- Dependency lock files (regenerated locally; not committed) ---
**/oh-package-lock.json5

# --- Local toolchain configuration (contains absolute paths) ---
local.properties
**/local.properties

# --- Signing material & secrets (NEVER commit) ---
signatures/
**/signatures/
*.p12
*.p7b
*.pem
*.cer
*.crt
*.keystore
*.jks

# --- Logs & temp ---
*.log
*.tmp

# --- Device-free unit-test build output (tests/run.sh) ---
.test-build/

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.iml

# --- Large model artefacts (built separately; never commit) ---
*.ms
*.onnx
*.mindir
.npmrc
**/.npmrc
.vscode/

# --- Python caches ---
__pycache__/
*.pyc
